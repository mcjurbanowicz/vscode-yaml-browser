{
  "name": "ado-yaml-inspector",
  "displayName": "Azure DevOps YAML Inspector",
  "description": "A VS Code extension for inspecting Azure DevOps YAML pipelines. Validates templates, resolves references, and provides navigation between template levels.",
  "version": "0.0.9",
  "publisher": "ado-inspector",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:yaml"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "test": "npm run compile && node --test",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package --allow-missing-repository --skip-license",
    "publish": "vsce publish"
  },
  "contributes": {
    "colors": [
      {
        "id": "adoInspector.stageIconForeground",
        "description": "Color for stage icons in the YAML Structure view.",
        "defaults": {
          "dark": "#C084FC",
          "light": "#9333EA",
          "highContrast": "#C084FC",
          "highContrastLight": "#6B21A8"
        }
      },
      {
        "id": "adoInspector.stageTemplateIconForeground",
        "description": "Color for stage template icons in the YAML Structure view.",
        "defaults": {
          "dark": "#A855F7",
          "light": "#6B21A8",
          "highContrast": "#A855F7",
          "highContrastLight": "#581C87"
        }
      },
      {
        "id": "adoInspector.jobIconForeground",
        "description": "Color for job icons in the YAML Structure view.",
        "defaults": {
          "dark": "#FB923C",
          "light": "#EA580C",
          "highContrast": "#FB923C",
          "highContrastLight": "#9A3412"
        }
      },
      {
        "id": "adoInspector.jobTemplateIconForeground",
        "description": "Color for job template icons in the YAML Structure view.",
        "defaults": {
          "dark": "#FACC15",
          "light": "#A16207",
          "highContrast": "#FACC15",
          "highContrastLight": "#854D0E"
        }
      },
      {
        "id": "adoInspector.stepIconForeground",
        "description": "Color for step icons in the YAML Structure view.",
        "defaults": {
          "dark": "#60A5FA",
          "light": "#2563EB",
          "highContrast": "#60A5FA",
          "highContrastLight": "#1E40AF"
        }
      },
      {
        "id": "adoInspector.stepTemplateIconForeground",
        "description": "Color for step template icons in the YAML Structure view.",
        "defaults": {
          "dark": "#3B82F6",
          "light": "#1E3A8A",
          "highContrast": "#3B82F6",
          "highContrastLight": "#172554"
        }
      }
    ],
    "commands": [
      {
        "command": "adoInspector.scanTemplates",
        "title": "Azure DevOps: Scan Templates",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.clearCache",
        "title": "Azure DevOps: Clear Cache",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.openReferencingFile",
        "title": "Azure DevOps: Find Template References",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.navigateToTemplate",
        "title": "Azure DevOps: Navigate to Template",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.navigateToYamlElement",
        "title": "Azure DevOps: Go to YAML Element",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.collapseYaml",
        "title": "Azure DevOps: Collapse YAML",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.expandYaml",
        "title": "Azure DevOps: Expand YAML",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.collapseStructureTree",
        "title": "Azure DevOps: Collapse YAML Structure",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.expandStructureTree",
        "title": "Azure DevOps: Expand YAML Structure",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.validateYaml",
        "title": "Azure DevOps: Validate YAML",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.toggleShowConditions",
        "title": "Azure DevOps: Toggle Show Conditions",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.toggleShowStageParameters",
        "title": "Azure DevOps: Toggle Show Stage Parameters",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.toggleShowJobParameters",
        "title": "Azure DevOps: Toggle Show Job Parameters",
        "category": "Azure DevOps YAML Inspector"
      },
      {
        "command": "adoInspector.toggleShowStepParameters",
        "title": "Azure DevOps: Toggle Show Step Parameters",
        "category": "Azure DevOps YAML Inspector"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "adoInspector.scanTemplates",
          "when": "config.adoInspector.enabled"
        },
        {
          "command": "adoInspector.clearCache",
          "when": "config.adoInspector.enabled"
        },
        {
          "command": "adoInspector.openReferencingFile",
          "when": "config.adoInspector.enabled"
        },
        {
          "command": "adoInspector.navigateToTemplate",
          "when": "config.adoInspector.enabled"
        },
        {
          "command": "adoInspector.collapseYaml",
          "when": "config.adoInspector.enabled && editorLangId == yaml"
        },
        {
          "command": "adoInspector.expandYaml",
          "when": "config.adoInspector.enabled && editorLangId == yaml"
        },
        {
          "command": "adoInspector.collapseStructureTree",
          "when": "config.adoInspector.enabled"
        },
        {
          "command": "adoInspector.expandStructureTree",
          "when": "config.adoInspector.enabled"
        },
        {
          "command": "adoInspector.validateYaml",
          "when": "config.adoInspector.enabled && editorLangId == yaml"
        },
        {
          "command": "adoInspector.toggleShowConditions",
          "when": "config.adoInspector.enabled && editorLangId == yaml"
        },
        {
          "command": "adoInspector.toggleShowStageParameters",
          "when": "config.adoInspector.enabled && editorLangId == yaml"
        },
        {
          "command": "adoInspector.toggleShowJobParameters",
          "when": "config.adoInspector.enabled && editorLangId == yaml"
        },
        {
          "command": "adoInspector.toggleShowStepParameters",
          "when": "config.adoInspector.enabled && editorLangId == yaml"
        }
      ],
      "view/title": [
        {
          "command": "adoInspector.collapseYaml",
          "when": "view == adoInspectorPanelStructureTree",
          "group": "2_editor",
          "title": "Collapse YAML",
          "icon": "$(collapse-all)"
        },
        {
          "command": "adoInspector.expandYaml",
          "when": "view == adoInspectorPanelStructureTree",
          "group": "2_editor",
          "title": "Expand YAML",
          "icon": "$(expand-all)"
        },
        {
          "command": "adoInspector.validateYaml",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml",
          "group": "navigation",
          "title": "Validate YAML",
          "icon": "$(check)"
        },
        {
          "command": "adoInspector.collapseStructureTree",
          "when": "view == adoInspectorPanelStructureTree",
          "group": "1_tree",
          "title": "Collapse Structure Tree",
          "icon": "$(collapse-all)"
        },
        {
          "command": "adoInspector.expandStructureTree",
          "when": "view == adoInspectorPanelStructureTree",
          "group": "1_tree",
          "title": "Expand Structure Tree",
          "icon": "$(expand-all)"
        },
        {
          "command": "adoInspector.toggleShowConditions",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml && !config.adoInspector.showConditions",
          "group": "1_showOptions",
          "title": "Show Conditions",
          "icon": "$(eye)"
        },
        {
          "command": "adoInspector.toggleShowConditions",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml && config.adoInspector.showConditions",
          "group": "1_showOptions",
          "title": "Hide Conditions",
          "icon": "$(eye-closed)"
        },
        {
          "command": "adoInspector.toggleShowStageParameters",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml && !config.adoInspector.showStageParameters",
          "group": "1_showOptions",
          "title": "Show Stage Parameters",
          "icon": "$(eye)"
        },
        {
          "command": "adoInspector.toggleShowStageParameters",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml && config.adoInspector.showStageParameters",
          "group": "1_showOptions",
          "title": "Hide Stage Parameters",
          "icon": "$(eye-closed)"
        },
        {
          "command": "adoInspector.toggleShowJobParameters",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml && !config.adoInspector.showJobParameters",
          "group": "1_showOptions",
          "title": "Show Job Parameters",
          "icon": "$(eye)"
        },
        {
          "command": "adoInspector.toggleShowJobParameters",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml && config.adoInspector.showJobParameters",
          "group": "1_showOptions",
          "title": "Hide Job Parameters",
          "icon": "$(eye-closed)"
        },
        {
          "command": "adoInspector.toggleShowStepParameters",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml && !config.adoInspector.showStepParameters",
          "group": "1_showOptions",
          "title": "Show Step Parameters",
          "icon": "$(eye)"
        },
        {
          "command": "adoInspector.toggleShowStepParameters",
          "when": "view == adoInspectorPanelStructureTree && editorLangId == yaml && config.adoInspector.showStepParameters",
          "group": "1_showOptions",
          "title": "Hide Step Parameters",
          "icon": "$(eye-closed)"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Azure DevOps YAML Inspector",
      "properties": {
        "adoInspector.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Azure DevOps YAML Inspector extension."
        },
        "adoInspector.scanRoot": {
          "type": "string",
          "default": ".",
          "description": "Root directory to scan for Azure DevOps YAML files. Can be an absolute path or relative to the workspace root."
        },
        "adoInspector.includePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.yml",
            "*.yaml"
          ],
          "description": "File patterns to include when scanning for YAML files."
        },
        "adoInspector.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/.git/**"
          ],
          "description": "File patterns to exclude when scanning for YAML files."
        },
        "adoInspector.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum depth of template traversal. A value of 3 means the extension will traverse up to 3 levels of nested templates."
        },
        "adoInspector.minDepth": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "Minimum depth of template traversal. A value of 1 excludes the root file itself."
        },
        "adoInspector.cacheEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable caching of resolved templates to avoid re-scanning."
        },
        "adoInspector.cachePath": {
          "type": "string",
          "default": "~/.ado-cache",
          "description": "Path to the cache directory for storing resolved templates."
        },
        "adoInspector.showPanel": {
          "type": "boolean",
          "default": true,
          "description": "Show the YAML Inspector panel when opening a YAML file."
        },
        "adoInspector.highlightReferences": {
          "type": "boolean",
          "default": true,
          "description": "Highlight template references in the editor."
        },
        "adoInspector.showConditions": {
          "type": "boolean",
          "default": false,
          "description": "Show condition expressions under stages, jobs, and steps in the YAML structure tree."
        },
        "adoInspector.showStageParameters": {
          "type": "boolean",
          "default": false,
          "description": "Show stage template parameters in the YAML structure tree."
        },
        "adoInspector.showJobParameters": {
          "type": "boolean",
          "default": false,
          "description": "Show job template parameters in the YAML structure tree."
        },
        "adoInspector.showStepParameters": {
          "type": "boolean",
          "default": false,
          "description": "Show step template parameters in the YAML structure tree."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "adoInspectorPanel",
          "title": "YAML Inspector",
          "icon": "resources/yaml-inspector.svg"
        }
      ]
    },
    "views": {
      "adoInspectorPanel": [
        {
          "id": "adoInspectorPanelStructureTree",
          "name": "YAML Structure"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.20.0",
    "typescript": "^5.8.0",
    "@vscode/vsce": "^3.1.0"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  }
}
